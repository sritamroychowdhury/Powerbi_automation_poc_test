# AWS Secrets Manager (credentials live here, not in this file — see utils/secrets_manager.py)
AWS_REGION=us-east-1
SNOWFLAKE_SECRET_NAME=powerbi-automation/snowflake
PBI_SECRET_NAME=powerbi-automation/powerbi

# Power BI (Azure AD service principal) — non-secret config only
PBI_WORKSPACE_ID=

# Playwright — path to a saved storage_state.json from an authenticated Power BI session.
# Generate one with: python -m playwright codegen https://app.powerbi.com --save-storage=playwright_storage_state.json
PLAYWRIGHT_STORAGE_STATE=./playwright_storage_state.json

# Claude -- no API key needed. utils/claude_agent.py shells out to the `claude` CLI in
# headless mode (claude -p ...), authenticating with whatever Claude Code login is active
# on the machine running pytest. Install + log in to Claude Code separately; there's no
# .env setting that substitutes for that.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_RCA_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
ANTHROPIC_RCA_EFFORT=medium
CLAUDE_CLI_TIMEOUT_S=180

# Jira (optional — Layer 5 governance wiring, disabled by default)
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug
